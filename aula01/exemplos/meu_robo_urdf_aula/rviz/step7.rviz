Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 0.4
      Cell Size: 0.1
      Color: 130; 140; 155
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: base_link
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /urdf_step7/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
      Frame Timeout: 15
      Marker Scale: 0.12
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
  Enabled: true
  Name: root
  Global Options:
    Fixed Frame: base_link
    Background Color: 238; 241; 247
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.3
      Focal Point:
        X: 0
        Y: 0
        Z: 0.52
      Pitch: 0.30
      Yaw: 0.75
      Near Clip Distance: 0.01
      Target Frame: base_link
      Value: Orbit (rviz)
  Value: true
Window Geometry:
  Height: 800
  Width: 1180
  X: 40
  Y: 40
