<?xml version="1.0" encoding="UTF-8"?>
<!--
  STEP 7 - Modelo didatico completo, sem alterar os Steps 1 a 6.
  Derivado das dimensoes do robo da aula: torso 0.4 x 0.3 x 0.6 m;
  bracos 0.1 x 0.1 x 0.4 m. Valores de massa/limites sao didaticos.

  UNIDADES: m, kg, rad, s; torque em N.m; forca em N.
  Este arquivo e URDF puro: nao exige expansao Xacro para abrir.
  As macros/propriedades Xacro ja foram apresentadas no Step 5.

  DEMONSTRACAO: RViz + joint_state_publisher_gui.
  Nao ha simulacao de torque, gravidade, contato ou imagens nesta etapa.
  Os blocos ros2_control e gazebo sao extensoes declarativas para estudo.
  Nenhum controller_manager, hardware ou plugin Gazebo e iniciado.
-->
<robot name="simple_robot_step7">

  <!-- 1. MATERIAIS: nomes reutilizaveis e cor RGBA. -->
  <material name="blue"><color rgba="0.07 0.30 0.72 1"/></material>
  <material name="teal"><color rgba="0.02 0.60 0.52 1"/></material>
  <material name="orange"><color rgba="0.93 0.42 0.06 1"/></material>
  <material name="gold"><color rgba="0.93 0.71 0.09 1"/></material>
  <material name="dark"><color rgba="0.08 0.10 0.15 1"/></material>
  <material name="gray"><color rgba="0.43 0.48 0.56 1"/></material>
  <material name="white"><color rgba="0.93 0.95 0.98 1"/></material>

  <!-- 2. BASE: frame raiz sem massa; os corpos fisicos sao filhos. -->
  <link name="base_link"/>

  <link name="base_plate_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.65 0.06"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.65 0.06"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4"/>
      <inertia ixx="0.142033333333" ixy="0" ixz="0"
               iyy="0.0845333333333" iyz="0" izz="0.224166666667"/>
    </inertial>
  </link>

  <joint name="base_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_plate_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.24"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.24"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.00426666666667" ixy="0" ixz="0"
               iyy="0.00426666666667" iyz="0" izz="0.000853333333333"/>
    </inertial>
  </link>

  <joint name="support_joint" type="fixed">
    <parent link="base_plate_link"/>
    <child link="support_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- 3. CORPO: visual, collision, inertial e origin sao conceitos distintos. -->

  <link name="torso_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.4 0.3 0.6"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.4 0.3 0.6"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.1875" ixy="0" ixz="0"
               iyy="0.216666666667" iyz="0" izz="0.104166666667"/>
    </inertial>
  </link>

  <joint name="torso_fixed_joint" type="fixed">
    <parent link="support_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
  </joint>

  <!-- 4. OMBROS: duas juntas revolute com limites e dinamica. -->

  <link name="left_arm_link">
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.4"/></geometry>
      <material name="teal"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.4"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.0141666666667" ixy="0" ixz="0"
               iyy="0.0141666666667" iyz="0" izz="0.00166666666667"/>
    </inertial>
  </link>

  <joint name="left_shoulder_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="left_arm_link"/>
    <origin xyz="0 0.22 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- lower/upper: rad; effort: N.m; velocity: rad/s. -->
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    <!-- damping: N.m.s/rad; friction: N.m. Nao simulados no RViz. -->
    <dynamics damping="0.15" friction="0.02"/>
    <!-- Limites suaves: interpretacao depende do software consumidor.
         Nao equivale a uma funcao de seguranca certificada. -->
    <safety_controller soft_lower_limit="-1.40" soft_upper_limit="1.40"
                       k_position="20.0" k_velocity="2.0"/>
  </joint>

  <link name="right_arm_link">
    <visual>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.4"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.4"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 -0.2" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.0141666666667" ixy="0" ixz="0"
               iyy="0.0141666666667" iyz="0" izz="0.00166666666667"/>
    </inertial>
  </link>

  <joint name="right_shoulder_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="right_arm_link"/>
    <origin xyz="0 -0.22 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- lower/upper: rad; effort: N.m; velocity: rad/s. -->
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    <!-- damping: N.m.s/rad; friction: N.m. Nao simulados no RViz. -->
    <dynamics damping="0.15" friction="0.02"/>
    <!-- Limites suaves: interpretacao depende do software consumidor.
         Nao equivale a uma funcao de seguranca certificada. -->
    <safety_controller soft_lower_limit="-1.40" soft_upper_limit="1.40"
                       k_position="20.0" k_velocity="2.0"/>
  </joint>

  <!-- 5. GARRA: prismatic + mimic, um comando para dois dedos. -->

  <link name="gripper_palm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.12 0.06"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.14 0.12 0.06"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000375" ixy="0" ixz="0"
               iyy="0.000483333333333" iyz="0" izz="0.000708333333333"/>
    </inertial>
  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="left_arm_link"/>
    <child link="gripper_palm_link"/>
    <origin xyz="0 0 -0.43" rpy="0 0 0"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.1 0.016 0.1"/></geometry>
      <material name="gold"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.1 0.016 0.1"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="6.83733333333e-05" ixy="0" ixz="0"
               iyy="0.000133333333333" iyz="0" izz="6.83733333333e-05"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_palm_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.035 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- Prismatic: posicao em m; effort em N; velocity em m/s. -->
    <limit lower="0.0" upper="0.04" effort="35.0" velocity="0.12"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.1 0.016 0.1"/></geometry>
      <material name="gold"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.1 0.016 0.1"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="6.83733333333e-05" ixy="0" ixz="0"
               iyy="0.000133333333333" iyz="0" izz="6.83733333333e-05"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_palm_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.035 -0.04" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.04" effort="35.0" velocity="0.12"/>
    <!-- Mimic: nao possui comando independente; acompanha left_finger_joint. -->
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <!-- 6. PUNHO: continuous, sem lower/upper. -->

  <link name="right_wrist_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
    </collision>
    <!-- Inercia de um cilindro, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00030625" ixy="0" ixz="0"
               iyy="0.000453125" iyz="0" izz="0.00030625"/>
    </inertial>
  </link>

  <joint name="right_wrist_joint" type="continuous">
    <parent link="right_arm_link"/>
    <child link="right_wrist_link"/>
    <origin xyz="0 0 -0.43" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- Continuous nao usa lower/upper; effort e velocity continuam uteis. -->
    <limit effort="4.0" velocity="2.5"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <!-- Pequeno marcador visual no punho para perceber rotacao no RViz. -->
  <link name="wrist_marker_link">
    <visual>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry><box size="0.018 0.014 0.10"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <geometry><box size="0.018 0.014 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.045 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="2.549e-05" ixy="0" ixz="0"
               iyy="2.581e-05" iyz="0" izz="1.12e-06"/>
    </inertial>
  </link>

  <joint name="wrist_marker_joint" type="fixed">
    <parent link="right_wrist_link"/>
    <child link="wrist_marker_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 7. CAMERA: frame mecanico e frame optico. -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.08 0.08"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.08 0.08"/></geometry>
    </collision>
    <!-- Inercia de um bloco homogeneo, expressa no centro de massa. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0004" ixy="0" ixz="0"
               iyy="0.00052" iyz="0" izz="0.00052"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="camera_link"/>
    <origin xyz="0.16 0 0.38" rpy="0 0.35 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- Convenção comum de frame optico: z para frente, x direita, y baixo. -->
    <origin xyz="0.07 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- 8. EXTENSAO ros2_control: declarada para leitura, nao ativada no launch. -->
  <ros2_control name="Step7DemoSystem" type="system">
    <hardware>
      <!-- Plugin genérico de teste. O launch NAO inicia controller_manager. -->
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <joint name="left_shoulder_joint">
      <command_interface name="position">
        <param name="min">-1.40</param>
        <param name="max">1.40</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="right_shoulder_joint">
      <command_interface name="position">
        <param name="min">-1.40</param>
        <param name="max">1.40</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.04</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- right_finger_joint usa mimic; nao recebe comando independente. -->
    <joint name="right_finger_joint">
      <param name="mimic">left_finger_joint</param>
      <param name="multiplier">1.0</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wrist_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- 9. TRANSMISSAO: exemplo didatico de reducao ideal 50:1.
         Nem todo parser URDF consome isto automaticamente. O hardware/plugin
         precisa implementar/usar a interface de transmissao. -->
    <transmission name="right_wrist_gearbox_50_to_1">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="right_wrist_motor" role="actuator"/>
      <joint name="right_wrist_joint" role="joint">
        <mechanical_reduction>50.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>
  </ros2_control>

  <!-- 10. EXTENSAO GAZEBO: preserva a ideia da camera do Step 6.
       Nao gera imagem sem iniciar Gazebo + bridge adequados. -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <topic>camera/image_raw</topic>
      <camera name="rgb_camera">
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
